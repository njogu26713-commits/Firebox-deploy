modules = ["nodejs-18", "web", "bash", "nix"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAIL = "bgithinji927@gmail.com"
GITHUB_WEBHOOK_SECRET = "placeholder_webhook_secret"
NODE_ENV = "production"
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]
build = ["npm", "install"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
