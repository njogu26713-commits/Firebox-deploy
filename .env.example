# ── Firebox Deploy — environment configuration ────────────────────────────
# Copy this file to .env and fill in real values before starting the server.

# Server
PORT=4000
NODE_ENV=production

# Mongo
MONGO_URI=mongodb://127.0.0.1:27017/firebox_deploy

# Auth
SESSION_SECRET=change_this_to_a_long_random_string
JWT_SECRET=change_this_too
ADMIN_EMAIL=admin@firebox.local
ADMIN_PASSWORD=change_me_on_first_login

# GitHub integration (optional — for repo picker and push webhooks)
GITHUB_WEBHOOK_SECRET=change_this_webhook_secret
